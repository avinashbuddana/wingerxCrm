# Public address
DOMAIN=crm.example.com
SERVER_URL=https://crm.example.com

# Image produced by Cloud Build and stored in Artifact Registry
WINGERX_IMAGE=asia-south1-docker.pkg.dev/your-gcp-project/wingerx/wingerx-crm:latest

# Core secrets: generate unique values and never commit the real .env file
APP_SECRET=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# PostgreSQL runs privately inside Docker Compose
PG_DATABASE_NAME=default
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace-with-openssl-rand-hex-32

# Application defaults
STORAGE_TYPE=local
IS_BILLING_ENABLED=false
SIGN_IN_PREFILLED=false
APPLICATION_LOG_DRIVER=CONSOLE

# Brevo SMTP
EMAIL_DRIVER=SMTP
EMAIL_FROM_NAME=WingerX
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_NO_TLS=false

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_VERSION=v23.0
META_WHATSAPP_DEFAULT_TEMPLATE=client_follow_up
META_WHATSAPP_DEFAULT_LANGUAGE=en_US
